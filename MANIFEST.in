include LICENSE THIRD_PARTY_NOTICES.md README.md README.zh-CN.md INSTALL.md TECHNICAL_REFERENCE.md CHANGELOG.md CONTRIBUTING.md AGENTS.md CLAUDE.md .gitignore .gitattributes
recursive-include jev_luna *.py *.mjs *.patch *.md *.go *.json
